# App Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# LLM Runtimes & Endpoints
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3  # or gemma2, phi3, etc.
OLLAMA_EMBED_MODEL=nomic-embed-text  # Model used for generating embeddings locally

# Cloud API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Gateway Logic
SIMILARITY_THRESHOLD=0.95  # Cosine similarity threshold for semantic cache (0.0 to 1.0)
COMPLEXITY_THRESHOLD_CHARS=150  # Prompts shorter than this are classified as simple
CACHE_DB_PATH=./semantic_cache.json  # JSON file database for semantic cache persistence

# Shared cache (several replicas): CACHE_BACKEND=redis
CACHE_BACKEND=file  # file or redis
REDIS_URL=redis://localhost:6379/0
CACHE_REFRESH_SECONDS=5  # redis only: how often a replica re-reads entries written by others

# Cost policy: cloud spend cap per UTC day in USD (0 = off)
DAILY_BUDGET_USD=0

# gRPC front end next to REST (0 = off)
GRPC_PORT=50051
